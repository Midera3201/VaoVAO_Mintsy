<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!-- Parametres de configuration du framework -->
    <context-param>
        <param-name>controller</param-name>
        <param-value>controller</param-value>
    </context-param>
    <context-param>
        <param-name>viewPrefix</param-name>
        <param-value>/WEB-INF/views/</param-value>
    </context-param>
    <context-param>
        <param-name>viewSuffix</param-name>
        <param-value>.jsp</param-value>
    </context-param>

    <!-- Parametres de connexion a la base de donnees -->
    <context-param>
        <param-name>db.driver</param-name>
        <param-value>org.postgresql.Driver</param-value>
    </context-param>
    <context-param>
        <param-name>db.url</param-name>
        <param-value>jdbc:postgresql://localhost:5432/vaovao</param-value>
    </context-param>
    <context-param>
        <param-name>db.user</param-name>
        <param-value>postgres</param-value>
    </context-param>
    <context-param>
        <param-name>db.password</param-name>
        <param-value>midera</param-value>
    </context-param>

    <!-- Sprint 9 : duree de vie de la session utilisateur.
         Le conteneur conserve les donnees de chaque session pendant
         30 minutes d'inactivite, puis les detruit automatiquement. -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Initialisation du framework au demarrage -->
    <listener>
        <listener-class>com.framework.listener.ApplicationListener</listener-class>
    </listener>

    <!-- Le servlet provient du .jar du framework (com.framework.FrontControllerServlet) -->
    <servlet>
        <servlet-name>FrontControllerServlet</servlet-name>
        <servlet-class>com.framework.FrontControllerServlet</servlet-class>

        <!-- Sprint 8 : reception des fichiers (multipart/form-data).
             Cette configuration prend le dessus sur l'annotation
             @MultipartConfig du servlet. Tailles en octets. -->
        <multipart-config>
            <max-file-size>10485760</max-file-size>       <!-- 10 Mo par fichier -->
            <max-request-size>26214400</max-request-size> <!-- 25 Mo par formulaire -->
            <file-size-threshold>1048576</file-size-threshold> <!-- 1 Mo avant ecriture sur disque -->
        </multipart-config>
    </servlet>

    <!-- Le Front Controller intercepte les requetes (sauf JSP et ressources statiques) -->
    <servlet-mapping>
        <servlet-name>FrontControllerServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

</web-app>
